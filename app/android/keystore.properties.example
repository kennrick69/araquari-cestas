# Preencher com os dados do keystore ORIGINAL do PWABuilder
# (o mesmo .keystore que está registrado na Google Play como chave de upload)
# Depois de preencher, salvar como "keystore.properties" (SEM .example) — está no .gitignore
storeFile=araquari.keystore
storePassword=COLE_AQUI
keyAlias=araquaricestas
keyPassword=COLE_AQUI
